{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "DISABLE_ESLINT_PLUGIN=true CI=false npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install --legacy-peer-deps",
  "redirects": [
    {
      "source": "/ciak-blueprint",
      "destination": "/blueprint",
      "permanent": true
    },
    {
      "source": "/ciak-blueprint/grazie",
      "destination": "/blueprint/grazie",
      "permanent": true
    },
    {
      "source": "/analisi",
      "destination": "/blueprint",
      "permanent": true
    },
    {
      "source": "/analisi/grazie",
      "destination": "/blueprint/grazie",
      "permanent": true
    },
    {
      "source": "/analisi-strategica",
      "destination": "/blueprint",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.ciak.html"
    },
    {
      "source": "/masterclass",
      "destination": "/masterclass.ciak.html"
    },
    {
      "source": "/masterclass/guarda",
      "destination": "/masterclass-guarda.ciak.html"
    },
    {
      "source": "/blueprint",
      "destination": "/blueprint.ciak.html"
    },
    {
      "source": "/blueprint/grazie",
      "destination": "/blueprint-grazie.ciak.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://evolution-pro-backend-dc2gzjsmdq-ew.a.run.app/api/$1"
    },
    {
      "source": "/((?!api/|static/|ciak/|images/|agents/|favicon|apple-touch-icon|site\\.webmanifest|og-|robots|sitemap|llms|index\\.).*)?",
      "destination": "/index.ciak.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.googletagmanager.com https://js.stripe.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.ciak.io https://evolution-pro-backend-977860235035.europe-west1.run.app https://*.googleapis.com https://api.stripe.com https://www.google-analytics.com https://region1.google-analytics.com https://*.cloudinary.com https://www.facebook.com https://connect.facebook.net wss:; frame-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com https://js.stripe.com https://hooks.stripe.com https://drive.google.com; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/ciak/(.*\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/index.ciak.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
