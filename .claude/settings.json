{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/blocca-git-add-tutto.py\"",
            "timeout": 10,
            "statusMessage": "Controllo git add"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stato-sessione.py\"",
            "timeout": 20,
            "statusMessage": "Stato repo e ultima staffetta"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/promemoria-handoff.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
